{
  "name": "ticketing-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ticketing frontend built with Composable Svelte",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && vite build --ssr",
    "build:client": "vite build",
    "build:server": "vite build --ssr",
    "start": "NODE_ENV=production node dist/server/index.js",
    "preview": "npm run build && npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-data.ts"
  },
  "dependencies": {
    "@composable-svelte/charts": "^0.1.0",
    "@composable-svelte/core": "^0.4.3",
    "@composable-svelte/maps": "^0.1.0",
    "@fastify/static": "^7.0.4",
    "clsx": "^2.1.1",
    "fastify": "^4.28.1",
    "svelte": "^5.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^20.14.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.3"
  }
}
